# ── AI Invoice Extraction ──────────────────────────────────────────
# Provider: Gemini 2.5 Flash (primary) → OpenRouter (fallback, same model)
# Both providers use the same Gemini 2.5 Flash model for consistent output.

# Google Gemini API (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter API (fallback for rate-limit/quota errors)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Comma-separated provider order: gemini,openrouter
AI_PROVIDER_ORDER=gemini,openrouter

# ── Jamaica Tariff Lookup ──────────────────────────────────────────
# Exact 10-digit codes are verified server-side against the public Jamaica
# Trade Portal without credentials. These optional credentials enable broad
# keyword and partial-code searches across the complete official catalogue.
# Never expose them as NEXT_PUBLIC_* values.
JAMAICA_TARIFF_API_TOKEN=
JAMAICA_TARIFF_API_SECRET=

# ── Payment (existing) ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# WIPAY_*
